{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Predictive signal definition ledger row",
  "type": "object",
  "required": [
    "definition_id",
    "candidate_name",
    "version",
    "status",
    "locked_at_utc",
    "feature",
    "cooldown_days",
    "primary_horizon_days",
    "change_policy",
    "payload_sha256"
  ],
  "properties": {
    "definition_id": {"type": "string", "minLength": 1},
    "candidate_name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"const": "locked"},
    "locked_at_utc": {"type": "string", "format": "date-time"},
    "feature": {
      "type": "object",
      "required": ["name", "window_observations", "threshold", "operator"]
    },
    "cooldown_days": {"type": "integer", "minimum": 1},
    "primary_horizon_days": {"type": "integer", "minimum": 1},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
