{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Predictive signal outcome ledger row",
  "type": "object",
  "required": [
    "outcome_id",
    "event_id",
    "definition_id",
    "definition_version",
    "evaluation_phase",
    "horizon_days",
    "maturity_date",
    "observed_at_utc",
    "sol_return",
    "direction_positive",
    "status",
    "payload_sha256"
  ],
  "properties": {
    "outcome_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "evaluation_phase": {"enum": ["retrospective", "prospective"]},
    "horizon_days": {"enum": [1, 3, 7, 14, 30]},
    "maturity_date": {"type": "string", "format": "date"},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "sol_return": {"type": "number"},
    "btc_return": {"type": ["number", "null"]},
    "btc_relative_return": {"type": ["number", "null"]},
    "direction_positive": {"type": "boolean"},
    "status": {"const": "observed"},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
